"""Register a regenerated 3-D prior through its calibrated image conditions.

The multi-view images used to create a TRELLIS asset were rendered from a
registered complete prior with known cameras.  They therefore provide a
strong, category-independent orientation and scale contract.  This module
first recovers that contract from complete silhouettes, then uses the saved
partial camera only for a bounded visible-surface residual Sim(3).
"""

from __future__ import annotations

from dataclasses import dataclass
import json
import math
from pathlib import Path

import cv2
import numpy as np
from PIL import Image
from scipy.spatial.transform import Rotation
import torch
import torch.nn.functional as functional

from src.bidirectional_cycle_registration import (
    interpolate_sim3,
    partial_to_prior_inverse_step,
    prepare_visible_target,
    sim3_parts,
    visible_score,
)
from src.ray_consistent_registration import apply_transform
from src.camera1_rendered_sim3 import _camera_matrix
from src.visible_pixel_sim3_refinement import local_camera1_visible_refine


@dataclass(frozen=True)
class ConditionCamera:
    name: str
    pose: np.ndarray
    mask: np.ndarray
    # Image generators may recenter an edited condition without changing its
    # intended 3-D view.  Keep that 2-D nuisance translation out of the shared
    # object Sim(3); projected scale remains genuine geometric evidence.
    image_scale: float = 1.0
    image_offset: tuple[float, float] = (0.0, 0.0)


def _foreground_mask(path: Path, resolution: int) -> np.ndarray:
    """Extract the central studio-object mask without category assumptions."""
    image = np.asarray(Image.open(path).convert("RGB"), dtype=np.uint8)
    border = np.concatenate((image[0], image[-1], image[:, 0], image[:, -1]), axis=0)
    background = np.median(border.astype(np.float32), axis=0)
    distance = np.linalg.norm(image.astype(np.float32) - background[None, None], axis=2)
    mask = distance > 18.0
    mask = cv2.morphologyEx(mask.astype(np.uint8), cv2.MORPH_CLOSE, np.ones((5, 5), np.uint8))
    count, labels, stats, _ = cv2.connectedComponentsWithStats(mask, connectivity=8)
    if count <= 1:
        raise ValueError(f"no foreground found in condition image: {path}")
    height, width = mask.shape
    centre = np.array([0.5 * width, 0.5 * height])
    keep = np.zeros_like(mask, dtype=np.uint8)
    areas = stats[1:, cv2.CC_STAT_AREA]
    largest = max(int(areas.max()), 1)
    for label in range(1, count):
        x, y, w, h, area = stats[label]
        component_centre = np.array([x + 0.5 * w, y + 0.5 * h])
        central = np.linalg.norm((component_centre - centre) / np.array([width, height])) < 0.43
        if area >= max(24, int(0.0025 * largest)) and (central or area >= 0.10 * largest):
            keep[labels == label] = 1
    keep = cv2.morphologyEx(keep, cv2.MORPH_CLOSE, np.ones((7, 7), np.uint8))
    resized = cv2.resize(keep, (resolution, resolution), interpolation=cv2.INTER_NEAREST)
    if int(resized.sum()) < 64:
        raise ValueError(f"foreground mask is too small: {path}")
    return resized.astype(bool)


def load_condition_contract(
    manifest_path: Path,
    condition_paths: dict[str, Path],
    *,
    resolution: int,
) -> tuple[list[ConditionCamera], dict]:
    manifest = json.loads(Path(manifest_path).read_text(encoding="utf-8"))
    views = {item["name"]: item for item in manifest["views"]}
    missing = sorted(set(condition_paths) - set(views))
    if missing:
        raise ValueError(f"condition views absent from render manifest: {missing}")
    cameras = []
    calibrations = {}
    for name, path in condition_paths.items():
        target_mask = _foreground_mask(path, resolution)
        image_scale = 1.0
        image_offset = np.zeros(2, dtype=np.float64)
        reference_path = Path(views[name].get("image", ""))
        if reference_path.is_file():
            reference_mask = _foreground_mask(reference_path, resolution)
            reference_centre, reference_spread = _mask_moments(reference_mask)
            target_centre, target_spread = _mask_moments(target_mask)
            axis_scales = target_spread / np.maximum(reference_spread, 1e-6)
            # Do not absorb edited object extent into a per-view zoom: doing
            # so hides exactly the scale/shape evidence that registration is
            # meant to preserve.  Only the independently drifting image
            # centre is treated as a nuisance camera parameter.
            image_offset = target_centre - reference_centre
        cameras.append(ConditionCamera(
            name=name,
            pose=np.asarray(views[name]["camera_pose"], dtype=np.float64),
            mask=target_mask,
            image_scale=image_scale,
            image_offset=(float(image_offset[0]), float(image_offset[1])),
        ))
        calibrations[name] = {
            "scale": image_scale,
            "offset": image_offset.tolist(),
            "observed_axis_scale": axis_scales.tolist() if reference_path.is_file() else None,
            "reference_image": str(reference_path) if reference_path.is_file() else None,
        }
    manifest = dict(manifest)
    manifest["condition_image_calibration"] = calibrations
    return cameras, manifest


def _project_perspective(
    points: np.ndarray,
    camera: ConditionCamera,
    field_of_view_degrees: float,
) -> tuple[np.ndarray, np.ndarray]:
    rotation = camera.pose[:3, :3]
    camera_points = (np.asarray(points, dtype=np.float64) - camera.pose[:3, 3]) @ rotation
    depth = -camera_points[:, 2]
    tangent = math.tan(math.radians(float(field_of_view_degrees)) * 0.5)
    uv = np.empty((len(points), 2), dtype=np.float64)
    uv[:, 0] = 0.5 + 0.5 * camera_points[:, 0] / np.maximum(depth * tangent, 1e-8)
    uv[:, 1] = 0.5 - 0.5 * camera_points[:, 1] / np.maximum(depth * tangent, 1e-8)
    normalised = 2.0 * uv - 1.0
    normalised = (
        float(camera.image_scale) * normalised
        + np.asarray(camera.image_offset, dtype=np.float64)[None]
    )
    uv = 0.5 * (normalised + 1.0)
    return uv, depth


def _render_mask(points: np.ndarray, camera: ConditionCamera, fov: float) -> np.ndarray:
    resolution = int(camera.mask.shape[0])
    uv, depth = _project_perspective(points, camera, fov)
    pixels = np.floor(uv * resolution).astype(np.int64)
    valid = (
        np.isfinite(uv).all(axis=1) & np.isfinite(depth) & (depth > 1e-8)
        & (pixels[:, 0] >= 0) & (pixels[:, 0] < resolution)
        & (pixels[:, 1] >= 0) & (pixels[:, 1] < resolution)
    )
    mask = np.zeros((resolution, resolution), dtype=np.uint8)
    mask[pixels[valid, 1], pixels[valid, 0]] = 1
    return cv2.dilate(mask, np.ones((3, 3), np.uint8), iterations=1).astype(bool)


def _mask_moments(mask: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
    """Return foreground centre and spread in a resolution-free image frame."""
    rows, columns = np.nonzero(np.asarray(mask, dtype=bool))
    if len(rows) == 0:
        return np.zeros(2, dtype=np.float64), np.ones(2, dtype=np.float64)
    height, width = mask.shape
    coordinates = np.column_stack((
        2.0 * columns / max(width - 1, 1) - 1.0,
        2.0 * rows / max(height - 1, 1) - 1.0,
    ))
    return coordinates.mean(axis=0), np.maximum(coordinates.std(axis=0), 1e-6)


def multiview_silhouette_score(
    points: np.ndarray,
    cameras: list[ConditionCamera],
    field_of_view_degrees: float,
) -> tuple[float, list[dict[str, float]]]:
    records = []
    for camera in cameras:
        rendered = _render_mask(points, camera, field_of_view_degrees)
        target = camera.mask
        intersection = int(np.count_nonzero(rendered & target))
        union = int(np.count_nonzero(rendered | target))
        rendered_count = int(np.count_nonzero(rendered))
        target_count = int(np.count_nonzero(target))
        iou = intersection / max(union, 1)
        coverage = intersection / max(target_count, 1)
        leakage = (rendered_count - intersection) / max(rendered_count, 1)
        rendered_centre, rendered_spread = _mask_moments(rendered)
        target_centre, target_spread = _mask_moments(target)
        centre_error = float(np.linalg.norm(rendered_centre - target_centre))
        spread_error = float(np.mean(np.abs(np.log(rendered_spread / target_spread))))
        moment_error = centre_error + 0.5 * spread_error
        energy = (
            0.62 * (1.0 - iou) + 0.19 * (1.0 - coverage) + 0.19 * leakage
            + 0.20 * moment_error
        )
        records.append({
            "name": camera.name,
            "iou": float(iou),
            "coverage": float(coverage),
            "leakage": float(leakage),
            "centre_error": centre_error,
            "spread_error": spread_error,
            "energy": float(energy),
        })
    energies = np.asarray([item["energy"] for item in records], dtype=np.float64)
    # The worst view matters: a front/back swap must not be hidden by one easy view.
    return float(0.75 * energies.mean() + 0.25 * energies.max()), records


def _batch_silhouette_energy(
    centred_points: np.ndarray,
    rotations: np.ndarray,
    scales: np.ndarray,
    centres: np.ndarray,
    cameras: list[ConditionCamera],
    fov: float,
    device: str,
) -> np.ndarray:
    points = torch.as_tensor(centred_points, dtype=torch.float32, device=device)
    rotations_t = torch.as_tensor(rotations, dtype=torch.float32, device=device)
    scales_t = torch.as_tensor(scales, dtype=torch.float32, device=device)
    centres_t = torch.as_tensor(centres, dtype=torch.float32, device=device)
    world = torch.einsum("nj,bkj->bnk", points, rotations_t)
    world = world * scales_t[:, None, None] + centres_t[:, None, :]
    resolution = int(cameras[0].mask.shape[0])
    tangent = math.tan(math.radians(float(fov)) * 0.5)
    coordinate = torch.linspace(-1.0, 1.0, resolution, dtype=torch.float32, device=device)
    grid_y, grid_x = torch.meshgrid(coordinate, coordinate, indexing="ij")
    grid = torch.stack((grid_x, grid_y), dim=-1).reshape(-1, 2)
    per_view = []
    for camera in cameras:
        pose_rotation = torch.as_tensor(camera.pose[:3, :3], dtype=torch.float32, device=device)
        eye = torch.as_tensor(camera.pose[:3, 3], dtype=torch.float32, device=device)
        camera_points = torch.einsum("bnj,jk->bnk", world - eye[None, None], pose_rotation)
        depth = -camera_points[..., 2]
        u = 0.5 + 0.5 * camera_points[..., 0] / (depth * tangent).clamp_min(1e-8)
        v = 0.5 - 0.5 * camera_points[..., 1] / (depth * tangent).clamp_min(1e-8)
        image_offset = torch.as_tensor(
            camera.image_offset, dtype=torch.float32, device=device,
        )
        u = 0.5 * (float(camera.image_scale) * (2.0 * u - 1.0) + image_offset[0] + 1.0)
        v = 0.5 * (float(camera.image_scale) * (2.0 * v - 1.0) + image_offset[1] + 1.0)
        x = torch.floor(u * resolution).long()
        y = torch.floor(v * resolution).long()
        valid = (depth > 1e-8) & (x >= 0) & (x < resolution) & (y >= 0) & (y < resolution)
        flat = torch.where(valid, y * resolution + x, torch.zeros_like(x))
        masks = torch.zeros((len(rotations), resolution * resolution), dtype=torch.float32, device=device)
        masks.scatter_(1, flat, valid.float())
        masks = functional.max_pool2d(
            masks.view(-1, 1, resolution, resolution), 3, 1, 1,
        ).view(len(rotations), -1)
        target = torch.as_tensor(camera.mask.reshape(-1), dtype=torch.float32, device=device)
        intersection = (masks * target[None]).sum(dim=1)
        rendered_count = masks.sum(dim=1).clamp_min(1.0)
        target_count = target.sum().clamp_min(1.0)
        union = rendered_count + target_count - intersection
        iou = intersection / union.clamp_min(1.0)
        coverage = intersection / target_count
        leakage = (rendered_count - intersection) / rendered_count
        target_mass = target.sum().clamp_min(1.0)
        target_centre = (target[:, None] * grid).sum(dim=0) / target_mass
        target_variance = (
            target[:, None] * torch.square(grid - target_centre[None])
        ).sum(dim=0) / target_mass
        rendered_centre = torch.einsum("bp,pc->bc", masks, grid) / rendered_count[:, None]
        rendered_variance = torch.einsum(
            "bp,bpc->bc", masks, torch.square(grid[None] - rendered_centre[:, None]),
        ) / rendered_count[:, None]
        centre_error = torch.linalg.norm(rendered_centre - target_centre[None], dim=1)
        spread_error = torch.abs(
            0.5 * torch.log(rendered_variance.clamp_min(1e-6))
            - 0.5 * torch.log(target_variance.clamp_min(1e-6))[None]
        ).mean(dim=1)
        moment_error = centre_error + 0.5 * spread_error
        per_view.append(
            0.62 * (1.0 - iou) + 0.19 * (1.0 - coverage) + 0.19 * leakage
            + 0.20 * moment_error
        )
    stacked = torch.stack(per_view, dim=1)
    energy = 0.75 * stacked.mean(dim=1) + 0.25 * stacked.max(dim=1).values
    return energy.detach().cpu().numpy().astype(np.float64)


def _axis_angle_matrix(vector: torch.Tensor) -> torch.Tensor:
    """Differentiable Rodrigues map for one axis-angle vector."""
    theta = torch.linalg.norm(vector).clamp_min(1e-8)
    axis = vector / theta
    x, y, z = axis.unbind()
    zero = torch.zeros((), dtype=vector.dtype, device=vector.device)
    skew = torch.stack((zero, -z, y, z, zero, -x, -y, x, zero)).reshape(3, 3)
    identity = torch.eye(3, dtype=vector.dtype, device=vector.device)
    return identity + torch.sin(theta) * skew + (1.0 - torch.cos(theta)) * (skew @ skew)


def _soft_occupancy(
    world: torch.Tensor,
    camera: ConditionCamera,
    fov: float,
    resolution: int,
) -> torch.Tensor:
    """Bilinearly splat points into a differentiable soft silhouette."""
    device, dtype = world.device, world.dtype
    pose_rotation = torch.as_tensor(camera.pose[:3, :3], dtype=dtype, device=device)
    eye = torch.as_tensor(camera.pose[:3, 3], dtype=dtype, device=device)
    camera_points = (world - eye[None]) @ pose_rotation
    depth = -camera_points[:, 2]
    tangent = math.tan(math.radians(float(fov)) * 0.5)
    u = 0.5 + 0.5 * camera_points[:, 0] / (depth * tangent).clamp_min(1e-8)
    v = 0.5 - 0.5 * camera_points[:, 1] / (depth * tangent).clamp_min(1e-8)
    image_offset = torch.as_tensor(camera.image_offset, dtype=dtype, device=device)
    u = 0.5 * (float(camera.image_scale) * (2.0 * u - 1.0) + image_offset[0] + 1.0)
    v = 0.5 * (float(camera.image_scale) * (2.0 * v - 1.0) + image_offset[1] + 1.0)
    px = u * (resolution - 1)
    py = v * (resolution - 1)
    x0, y0 = torch.floor(px).long(), torch.floor(py).long()
    dx, dy = px - x0.to(dtype), py - y0.to(dtype)
    mass = torch.zeros(resolution * resolution, dtype=dtype, device=device)
    valid_depth = depth > 1e-8
    for ox, oy, weight in (
        (0, 0, (1.0 - dx) * (1.0 - dy)),
        (1, 0, dx * (1.0 - dy)),
        (0, 1, (1.0 - dx) * dy),
        (1, 1, dx * dy),
    ):
        x, y = x0 + ox, y0 + oy
        valid = valid_depth & (x >= 0) & (x < resolution) & (y >= 0) & (y < resolution)
        index = torch.where(valid, y * resolution + x, torch.zeros_like(x))
        mass.scatter_add_(0, index, torch.where(valid, weight, torch.zeros_like(weight)))
    occupancy = 1.0 - torch.exp(-2.5 * mass.view(1, 1, resolution, resolution))
    kernel = torch.tensor(
        [[1.0, 2.0, 1.0], [2.0, 4.0, 2.0], [1.0, 2.0, 1.0]],
        dtype=dtype, device=device,
    ).view(1, 1, 3, 3) / 16.0
    return functional.conv2d(occupancy, kernel, padding=1)[0, 0].clamp(0.0, 1.0)


def differentiable_multiview_refine(
    centred_points: np.ndarray,
    rotation: np.ndarray,
    scale: float,
    world_centre: np.ndarray,
    cameras: list[ConditionCamera],
    fov: float,
    *,
    target_radius: float,
    device: str,
    steps: int = 320,
    max_rotation_degrees: float = 40.0,
    max_log_scale: float = math.log(1.28),
    max_centre_ratio: float = 0.35,
) -> tuple[np.ndarray, float, np.ndarray, dict]:
    """Refine one semantic orientation basin with soft multi-view rendering."""
    points = torch.as_tensor(centred_points, dtype=torch.float32, device=device)
    base_rotation = torch.as_tensor(rotation, dtype=torch.float32, device=device)
    base_centre = torch.as_tensor(world_centre, dtype=torch.float32, device=device)
    coordinate = torch.linspace(-1.0, 1.0, int(cameras[0].mask.shape[0]), device=device)
    grid_y, grid_x = torch.meshgrid(coordinate, coordinate, indexing="ij")
    grid = torch.stack((grid_x, grid_y), dim=-1)

    def moments(mask: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
        mass = mask.sum().clamp_min(1.0)
        centre = (mask[..., None] * grid).sum(dim=(0, 1)) / mass
        variance = (
            mask[..., None] * torch.square(grid - centre[None, None])
        ).sum(dim=(0, 1)) / mass
        return centre, torch.sqrt(variance.clamp_min(1e-6))

    targets = []
    for camera in cameras:
        target = torch.as_tensor(camera.mask, dtype=torch.float32, device=device)[None, None]
        target = functional.avg_pool2d(target, 3, stride=1, padding=1)[0, 0]
        target_centre, target_spread = moments(target)
        targets.append((target, target_centre, target_spread))
    raw = torch.zeros(7, dtype=torch.float32, device=device, requires_grad=True)
    optimizer = torch.optim.Adam([raw], lr=0.045)
    history = []
    best = None
    for iteration in range(int(steps)):
        optimizer.zero_grad(set_to_none=True)
        delta_rotvec = torch.tanh(raw[:3]) * (
            math.radians(float(max_rotation_degrees)) / math.sqrt(3.0)
        )
        delta_rotation = _axis_angle_matrix(delta_rotvec)
        current_rotation = delta_rotation @ base_rotation
        current_scale = float(scale) * torch.exp(torch.tanh(raw[3]) * float(max_log_scale))
        current_centre = base_centre + torch.tanh(raw[4:7]) * (
            float(max_centre_ratio) * float(target_radius)
        )
        world = (points @ current_rotation.T) * current_scale + current_centre[None]
        losses = []
        moment_losses = []
        for camera, (target, target_centre, target_spread) in zip(cameras, targets):
            occupancy = _soft_occupancy(world, camera, fov, int(target.shape[0]))
            intersection = (occupancy * target).sum()
            dice = 1.0 - (2.0 * intersection + 1.0) / (
                occupancy.sum() + target.sum() + 1.0
            )
            outside = (occupancy * (1.0 - target)).sum() / occupancy.sum().clamp_min(1.0)
            uncovered = (target * (1.0 - occupancy)).sum() / target.sum().clamp_min(1.0)
            predicted_centre, predicted_spread = moments(occupancy)
            centre_loss = functional.smooth_l1_loss(
                predicted_centre, target_centre, beta=0.02,
            )
            spread_loss = functional.smooth_l1_loss(
                torch.log(predicted_spread), torch.log(target_spread), beta=0.02,
            )
            moment_loss = centre_loss + 0.5 * spread_loss
            losses.append(
                0.66 * dice + 0.17 * outside + 0.17 * uncovered
                + 0.35 * moment_loss
            )
            moment_losses.append(moment_loss)
        view_losses = torch.stack(losses)
        data_loss = 0.75 * view_losses.mean() + 0.25 * view_losses.max()
        regularizer = (
            0.008 * torch.square(delta_rotvec / math.radians(max_rotation_degrees)).sum()
            + 0.004 * torch.square(torch.tanh(raw[3]))
            + 0.004 * torch.square(torch.tanh(raw[4:7])).sum()
        )
        loss = data_loss + regularizer
        loss.backward()
        optimizer.step()
        value = float(loss.detach().cpu())
        if best is None or value < best[0]:
            best = (
                value,
                current_rotation.detach().cpu().numpy().astype(np.float64),
                float(current_scale.detach().cpu()),
                current_centre.detach().cpu().numpy().astype(np.float64),
                float(data_loss.detach().cpu()),
                np.asarray([float(item.detach().cpu()) for item in view_losses]),
                np.asarray([float(item.detach().cpu()) for item in moment_losses]),
                delta_rotvec.detach().cpu().numpy().astype(np.float64),
            )
        if iteration % 20 == 0 or iteration == int(steps) - 1:
            history.append({
                "iteration": iteration,
                "loss": value,
                "data_loss": float(data_loss.detach().cpu()),
            })
    assert best is not None
    return best[1], best[2], best[3], {
        "steps": int(steps),
        "best_loss": best[0],
        "best_data_loss": best[4],
        "per_view_soft_loss": best[5].tolist(),
        "per_view_moment_loss": best[6].tolist(),
        "delta_rotation_degrees": float(np.degrees(np.linalg.norm(best[7]))),
        "history": history,
    }


def _camera1_targets(partial: np.ndarray, projector, semantic_path: Path,
                     resolution: int) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
    semantic = _foreground_mask(semantic_path, resolution)
    uv, depth = projector.project(partial)
    height, width = projector.image_shape
    uv = uv / np.array([width - 1, height - 1], dtype=np.float64)
    pixels = np.floor(uv * resolution).astype(np.int64)
    valid = (
        np.isfinite(uv).all(axis=1) & np.isfinite(depth)
        & (pixels[:, 0] >= 0) & (pixels[:, 0] < resolution)
        & (pixels[:, 1] >= 0) & (pixels[:, 1] < resolution)
    )
    flat = pixels[valid, 1] * resolution + pixels[valid, 0]
    target_depth = np.full(resolution * resolution, np.inf, dtype=np.float64)
    np.minimum.at(target_depth, flat, np.asarray(depth, dtype=np.float64)[valid])
    target_depth = target_depth.reshape(resolution, resolution)
    partial_mask = np.isfinite(target_depth)
    partial_mask = cv2.dilate(partial_mask.astype(np.uint8), np.ones((3, 3), np.uint8)).astype(bool)
    return semantic, partial_mask, target_depth


def _soft_camera1_maps(world: torch.Tensor, projector, resolution: int,
                       diagonal: float) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
    device, dtype = world.device, world.dtype
    linear, offset = _camera_matrix(projector)
    linear_t = torch.as_tensor(linear, dtype=dtype, device=device)
    offset_t = torch.as_tensor(offset, dtype=dtype, device=device)
    camera_points = world @ linear_t + offset_t[None]
    centre_xy = torch.as_tensor(projector.center_xy, dtype=dtype, device=device)
    uv = (camera_points[:, :2] - centre_xy[None]) / float(projector.scale_xy)
    uv = uv * (1.0 - 2.0 * float(projector.padding)) + 0.5
    uv = torch.stack((uv[:, 0], 1.0 - uv[:, 1]), dim=1)
    px, py = uv[:, 0] * (resolution - 1), uv[:, 1] * (resolution - 1)
    x0, y0 = torch.floor(px).long(), torch.floor(py).long()
    dx, dy = px - x0.to(dtype), py - y0.to(dtype)
    depth = camera_points[:, 2]
    depth_origin = depth.min().detach()
    depth_weight = torch.exp(-12.0 * (depth - depth_origin) / max(float(diagonal), 1e-8))
    mass = torch.zeros(resolution * resolution, dtype=dtype, device=device)
    depth_mass = torch.zeros_like(mass)
    valid_depth = torch.isfinite(depth)
    for ox, oy, spatial in (
        (0, 0, (1.0 - dx) * (1.0 - dy)),
        (1, 0, dx * (1.0 - dy)),
        (0, 1, (1.0 - dx) * dy),
        (1, 1, dx * dy),
    ):
        x, y = x0 + ox, y0 + oy
        valid = valid_depth & (x >= 0) & (x < resolution) & (y >= 0) & (y < resolution)
        index = torch.where(valid, y * resolution + x, torch.zeros_like(x))
        weight = torch.where(valid, spatial * depth_weight, torch.zeros_like(spatial))
        mass.scatter_add_(0, index, weight)
        depth_mass.scatter_add_(0, index, weight * depth)
    mass_2d = mass.view(resolution, resolution)
    occupancy = 1.0 - torch.exp(-2.5 * mass_2d)
    predicted_depth = depth_mass.view(resolution, resolution) / mass_2d.clamp_min(1e-6)
    return occupancy, predicted_depth, mass_2d


def differentiable_camera1_refine(
    points: np.ndarray,
    partial: np.ndarray,
    projector,
    semantic_path: Path,
    *,
    diagonal: float,
    device: str,
    resolution: int = 128,
    steps: int = 220,
) -> tuple[np.ndarray, np.ndarray, dict]:
    """Fit one-way pixel-depth evidence without penalising hidden prior support."""
    rng = np.random.default_rng(6145)
    ids = rng.choice(len(points), min(6_000, len(points)), replace=False)
    partial_ids = rng.choice(len(partial), min(2_048, len(partial)), replace=False)
    sampled = np.asarray(points, dtype=np.float64)[ids]
    observed = np.asarray(partial, dtype=np.float64)[partial_ids]
    centre = np.median(sampled, axis=0)
    points_t = torch.as_tensor(sampled - centre, dtype=torch.float32, device=device)
    centre_t = torch.as_tensor(centre, dtype=torch.float32, device=device)
    linear, offset = _camera_matrix(projector)
    linear_t = torch.as_tensor(linear, dtype=torch.float32, device=device)
    offset_t = torch.as_tensor(offset, dtype=torch.float32, device=device)
    observed_t = torch.as_tensor(observed, dtype=torch.float32, device=device)

    def camera_features(world: torch.Tensor) -> torch.Tensor:
        camera_points = world @ linear_t + offset_t[None]
        centre_xy = torch.as_tensor(projector.center_xy, dtype=torch.float32, device=device)
        uv = (camera_points[:, :2] - centre_xy[None]) / float(projector.scale_xy)
        # Pixel coordinates and depth share a dimensionless metric.  Depth is
        # weighted more strongly because the complete silhouette alone is
        # projectively ambiguous.
        return torch.cat((uv, 2.5 * camera_points[:, 2:3] / float(diagonal)), dim=1)

    target_features = camera_features(observed_t).detach()
    raw = torch.zeros(7, dtype=torch.float32, device=device, requires_grad=True)
    optimizer = torch.optim.Adam([raw], lr=0.030)
    best = None
    history = []
    max_angle = math.radians(12.0)
    for iteration in range(int(steps)):
        optimizer.zero_grad(set_to_none=True)
        rotvec = torch.tanh(raw[:3]) * (max_angle / math.sqrt(3.0))
        rotation = _axis_angle_matrix(rotvec)
        scale = torch.exp(torch.tanh(raw[3]) * math.log(1.06))
        translation = torch.tanh(raw[4:7]) * (0.080 * float(diagonal))
        world = (points_t @ rotation.T) * scale + centre_t[None] + translation[None]
        source_features = camera_features(world)
        nearest = []
        for start in range(0, len(target_features), 256):
            distances = torch.cdist(target_features[start:start + 256], source_features)
            nearest.append(distances.min(dim=1).values)
        nearest = torch.cat(nearest)
        # A smooth robust penalty keeps sparse scan outliers finite without
        # trimming away distant but valid structures such as thin limbs.
        correspondence_loss = torch.sqrt(torch.square(nearest) + 1e-5).mean()
        loss = (
            correspondence_loss
            + 0.006 * torch.square(rotvec / max_angle).sum()
            + 0.004 * torch.square(torch.tanh(raw[3]))
            + 0.002 * torch.square(torch.tanh(raw[4:7])).sum()
        )
        loss.backward()
        optimizer.step()
        value = float(loss.detach().cpu())
        if best is None or value < best[0]:
            best = (
                value,
                rotation.detach().cpu().numpy().astype(np.float64),
                float(scale.detach().cpu()),
                translation.detach().cpu().numpy().astype(np.float64),
                float(correspondence_loss.detach().cpu()),
                rotvec.detach().cpu().numpy().astype(np.float64),
            )
        if iteration % 20 == 0 or iteration == int(steps) - 1:
            history.append({"iteration": iteration, "loss": value})
    assert best is not None
    step = _make_transform(centre, best[1], best[2], centre + best[3])
    moved = apply_transform(points, step)
    return moved, step, {
        "steps": int(steps),
        "best_loss": best[0],
        "pixel_depth_correspondence_loss": best[4],
        "partial_samples": int(len(observed)),
        "prior_samples": int(len(sampled)),
        "delta_rotation_degrees": float(np.degrees(np.linalg.norm(best[5]))),
        "delta_scale": best[2],
        "delta_translation": best[3].tolist(),
        "history": history,
    }


def _make_transform(source_centre: np.ndarray, rotation: np.ndarray, scale: float,
                    world_centre: np.ndarray) -> np.ndarray:
    transform = np.eye(4, dtype=np.float64)
    transform[:3, :3] = float(scale) * np.asarray(rotation, dtype=np.float64)
    transform[:3, 3] = np.asarray(world_centre) - transform[:3, :3] @ source_centre
    return transform


def _state_from_transform(transform: np.ndarray, source_centre: np.ndarray):
    scale, rotation, translation = sim3_parts(transform)
    return rotation, scale, scale * rotation @ source_centre + translation


def register_from_multiview_conditions(
    source: np.ndarray,
    partial: np.ndarray,
    projector,
    *,
    manifest_path: Path,
    condition_paths: dict[str, Path],
    selection_json: Path | None = None,
    semantic_path: Path | None = None,
    seed: int = 6145,
    rotation_candidates: int = 4096,
    source_samples: int = 8192,
    render_resolution: int = 128,
    device: str = "cuda",
) -> tuple[np.ndarray, dict]:
    """Estimate a proper Sim(3) from calibrated complete views and partial depth."""
    source = np.asarray(source, dtype=np.float64)
    partial = np.asarray(partial, dtype=np.float64)
    if min(len(source), len(partial)) < 64:
        raise ValueError("source and partial need at least 64 points")
    if device.startswith("cuda") and not torch.cuda.is_available():
        device = "cpu"
    cameras, manifest = load_condition_contract(
        manifest_path, condition_paths, resolution=render_resolution,
    )
    fov = float(manifest["field_of_view_degrees"])
    target_centre = np.asarray(manifest["centre"], dtype=np.float64)
    target_radius = float(manifest["radius"])
    rng = np.random.default_rng(seed)
    ids = rng.choice(len(source), min(int(source_samples), len(source)), replace=False)
    sampled = source[ids]
    source_centre = np.median(sampled, axis=0)
    source_radius = float(np.quantile(np.linalg.norm(sampled - source_centre, axis=1), 0.995))
    base_scale = target_radius / max(source_radius, 1e-12)
    if selection_json is None:
        rotations = np.concatenate([
            np.eye(3, dtype=np.float64)[None],
            Rotation.random(int(rotation_candidates), random_state=rng).as_matrix(),
        ])
        orientation_source = "random_so3"
    else:
        selection = json.loads(Path(selection_json).read_text(encoding="utf-8"))
        target_front = next(item for item in manifest["views"] if item["name"] == "front")
        target_basis = np.asarray(target_front["camera_pose"], dtype=np.float64)[:3, :3]
        # RGB retrieval resolves front/back semantics.  Multi-view rendering
        # then refines only the best semantic basin continuously.
        proposal = selection.get("selected", selection["top"][0])
        source_basis = np.asarray(proposal["camera_pose"], dtype=np.float64)[:3, :3]
        rotations = (target_basis @ source_basis.T)[None]
        orientation_source = "rgb_retrieved_condition_camera"
    scale_factors = np.asarray([0.86, 0.93, 1.0, 1.07, 1.14], dtype=np.float64)
    candidate_rotations = np.repeat(rotations, len(scale_factors), axis=0)
    candidate_scales = np.tile(base_scale * scale_factors, len(rotations))
    candidate_centres = np.repeat(target_centre[None], len(candidate_rotations), axis=0)
    energies = np.empty(len(candidate_rotations), dtype=np.float64)
    batch_size = 32 if device.startswith("cuda") else 4
    centred_sample = sampled - source_centre
    for start in range(0, len(candidate_rotations), batch_size):
        stop = min(start + batch_size, len(candidate_rotations))
        energies[start:stop] = _batch_silhouette_energy(
            centred_sample,
            candidate_rotations[start:stop],
            candidate_scales[start:stop],
            candidate_centres[start:stop],
            cameras, fov, device,
        )
    best = int(np.argmin(energies))
    rotation = candidate_rotations[best]
    scale = float(candidate_scales[best])
    world_centre = target_centre.copy()

    rotation, scale, world_centre, differentiable = differentiable_multiview_refine(
        centred_sample, rotation, scale, world_centre, cameras, fov,
        target_radius=target_radius, device=device,
    )

    # Deterministic multi-view coordinate continuation closes the spacing
    # between random SO(3) samples while retaining the calibrated view basin.
    continuation = []
    axes = np.eye(3, dtype=np.float64)
    for angle_degrees, scale_delta, centre_ratio in (
        (8.0, 0.050, 0.035), (3.0, 0.022, 0.016),
        (1.0, 0.009, 0.007), (0.35, 0.003, 0.0025),
    ):
        # A level may need a scale, rotation, and translation update in
        # succession.  Stop on the first identity choice instead of imposing
        # an arbitrary two-action budget.
        for _ in range(6):
            proposals = [(rotation, scale, world_centre, "identity")]
            for axis_index, axis in enumerate(axes):
                for sign in (-1.0, 1.0):
                    delta = Rotation.from_rotvec(
                        axis * math.radians(sign * angle_degrees),
                    ).as_matrix()
                    proposals.append((delta @ rotation, scale, world_centre,
                                      f"rotate_{axis_index}_{sign:+.0f}"))
            for sign in (-1.0, 1.0):
                proposals.append((rotation, scale * (1.0 + sign * scale_delta), world_centre,
                                  f"scale_{sign:+.0f}"))
            for axis_index, axis in enumerate(axes):
                for sign in (-1.0, 1.0):
                    proposals.append((rotation, scale,
                                      world_centre + sign * centre_ratio * target_radius * axis,
                                      f"translate_{axis_index}_{sign:+.0f}"))
            proposal_rotations = np.stack([item[0] for item in proposals])
            proposal_scales = np.asarray([item[1] for item in proposals])
            proposal_centres = np.stack([item[2] for item in proposals])
            proposal_energies = _batch_silhouette_energy(
                centred_sample, proposal_rotations, proposal_scales, proposal_centres,
                cameras, fov, device,
            )
            chosen = int(np.argmin(proposal_energies))
            rotation, scale, world_centre, action = proposals[chosen]
            continuation.append({
                "angle_degrees": angle_degrees,
                "scale_delta": scale_delta,
                "centre_ratio": centre_ratio,
                "action": action,
                "energy": float(proposal_energies[chosen]),
            })
            if chosen == 0:
                break

    condition_transform = _make_transform(source_centre, rotation, scale, world_centre)
    condition_registered = apply_transform(source, condition_transform)
    multiview_before, per_view_before = multiview_silhouette_score(
        condition_registered[ids], cameras, fov,
    )
    target_cache = prepare_visible_target(partial, projector)
    diagonal = max(float(np.linalg.norm(np.ptp(partial, axis=0))), 1e-8)
    visible_before = visible_score(
        partial, condition_registered, projector, diagonal,
        pixel_radius=5.0, target_cache=target_cache,
    )

    # Build the Camera-1 optimum with the same broad-to-narrow 2-D+3-D score
    # used by the fixed object pipeline.  This is only the second Pareto
    # endpoint; it is not accepted blindly because a partial view is
    # projectively ambiguous.
    endpoint = condition_registered.copy()
    endpoint_transform = condition_transform.copy()
    camera1_history = []
    for levels in (
        ((.010, 10.0, .010), (.004, 3.5, .004), (.001, 1.0, .001)),
        ((.010, 3.0, .010), (.004, 1.05, .004), (.001, .30, .001)),
        ((.010, 1.0, .010), (.004, .35, .004), (.001, .10, .001)),
    ):
        step, record = local_camera1_visible_refine(
            partial, endpoint, projector, diagonal=diagonal,
            search_points=32_000, candidate_workers=8, levels=levels,
        )
        endpoint = apply_transform(endpoint, step)
        endpoint_transform = step @ endpoint_transform
        camera1_history.append(record)

    # Select the knee of the no-GT Pareto curve in Sim(3), rather than using
    # a hand-tuned weighted sum.  Min-max normalisation gives both modalities
    # one unit of regret and is shared across categories and datasets.
    relative = endpoint_transform @ np.linalg.inv(condition_transform)
    fractions = np.linspace(0.0, 1.0, 9)
    candidates = []
    for fraction in fractions:
        transform = interpolate_sim3(relative, float(fraction)) @ condition_transform
        candidate = apply_transform(source, transform)
        multiview, per_view = multiview_silhouette_score(candidate[ids], cameras, fov)
        visible = visible_score(
            partial, candidate, projector, diagonal,
            pixel_radius=5.0, target_cache=target_cache,
        )
        candidates.append({
            "fraction": float(fraction),
            "transform": transform,
            "points": candidate,
            "multiview": float(multiview),
            "per_view": per_view,
            "visible": visible,
        })
    mv_values = np.asarray([item["multiview"] for item in candidates])
    visible_values = np.asarray([item["visible"]["objective"] for item in candidates])
    mv_regret = (mv_values - mv_values.min()) / max(float(np.ptp(mv_values)), 1e-8)
    visible_regret = (visible_values - visible_values.min()) / max(float(np.ptp(visible_values)), 1e-8)
    regrets = mv_regret + visible_regret
    selected_index = int(np.argmin(regrets))
    selected = candidates[selected_index]
    current = selected["points"]
    accumulated = selected["transform"]
    visible_after = selected["visible"]
    multiview_after = selected["multiview"]
    per_view_after = selected["per_view"]
    final_scale, final_rotation, final_translation = sim3_parts(accumulated)
    return current, {
        "method": "calibrated_condition_multiview_then_partial_depth_sim3",
        "strict_zero_shot": True,
        "ground_truth_cd_emd_used": False,
        "previous_complete_geometry_used": False,
        "condition_views": list(condition_paths),
        "render_manifest": str(Path(manifest_path).resolve()),
        "condition_image_calibration": manifest.get("condition_image_calibration", {}),
        "rotation_candidates": int(len(rotations)),
        "scale_candidates_per_rotation": int(len(scale_factors)),
        "source_samples": int(len(sampled)),
        "render_resolution": int(render_resolution),
        "condition_search": {
            "orientation_source": orientation_source,
            "selection_json": None if selection_json is None else str(Path(selection_json).resolve()),
            "base_scale": float(base_scale),
            "selected_global_index": best,
            "selected_global_energy": float(energies[best]),
            "differentiable_multiview": differentiable,
            "continuation": continuation,
            "multiview_before_partial_refine": float(multiview_before),
            "per_view_before_partial_refine": per_view_before,
        },
        "camera1_endpoint": camera1_history,
        "joint_pareto_selection": {
            "criterion": "minimum_equal_normalised_regret",
            "selected_index": selected_index,
            "selected_fraction": selected["fraction"],
            "candidates": [
                {
                    "fraction": item["fraction"],
                    "multiview_objective": item["multiview"],
                    "visible_objective": float(item["visible"]["objective"]),
                    "multiview_regret": float(mv_regret[index]),
                    "visible_regret": float(visible_regret[index]),
                    "total_regret": float(regrets[index]),
                    "per_view": item["per_view"],
                }
                for index, item in enumerate(candidates)
            ],
        },
        "final": {
            "scale": float(final_scale),
            "rotation": final_rotation.tolist(),
            "translation": final_translation.tolist(),
            "transform": accumulated.tolist(),
            "multiview_objective": float(multiview_after),
            "per_view": per_view_after,
            "visible_objective": float(visible_after["objective"]),
            "visible_geometric": float(visible_after["geometric"]["objective"]),
            "projection": {
                key: float(value) for key, value in visible_after["projection"].items()
            },
        },
    }


def draw_condition_projection_board(
    path: Path,
    points: np.ndarray,
    condition_paths: dict[str, Path],
    cameras: list[ConditionCamera],
    fov: float,
) -> None:
    panels = []
    for camera in cameras:
        image = np.asarray(Image.open(condition_paths[camera.name]).convert("RGB"), dtype=np.uint8)
        height, width = image.shape[:2]
        uv, depth = _project_perspective(points, camera, fov)
        xy = np.rint(uv * np.array([width - 1, height - 1])).astype(np.int64)
        valid = (
            np.isfinite(uv).all(axis=1) & np.isfinite(depth) & (depth > 1e-8)
            & (xy[:, 0] >= 0) & (xy[:, 0] < width)
            & (xy[:, 1] >= 0) & (xy[:, 1] < height)
        )
        overlay = image.copy()
        overlay[xy[valid, 1], xy[valid, 0]] = np.array([255, 0, 0], dtype=np.uint8)
        overlay = cv2.resize(overlay, (512, 512), interpolation=cv2.INTER_AREA)
        panels.append(Image.fromarray(overlay))
    board = Image.new("RGB", (512 * len(panels), 512), "white")
    for index, panel in enumerate(panels):
        board.paste(panel, (512 * index, 0))
    Path(path).parent.mkdir(parents=True, exist_ok=True)
    board.save(path)
